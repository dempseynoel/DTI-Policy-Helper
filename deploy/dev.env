# dev: non-secret configuration, GENERATED by `terraform apply` in infra/dev.
# Don't edit it. Change deploy/environments.yaml (or infra/), apply, and commit this file.
# No keys: auth is Entra ID (DefaultAzureCredential) everywhere.

APP_ENV=dev

# Foundry / Azure OpenAI (Lesson 01)
AZURE_OPENAI_ENDPOINT=https://ai-dti-rag-dev.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=chat
AZURE_OPENAI_EMBED_DEPLOYMENT=embed

# Azure AI Search (Lesson 01). The index name is NOT here: it is versioned in code (Lesson 04).
AZURE_SEARCH_ENDPOINT=https://srch-dti-rag-dev.search.windows.net
AZURE_SEARCH_API_VERSION=2024-07-01

# Management-plane coordinates: which model versions are serving (Lesson 04) and drift
# checks (Lesson 13).
AZURE_SUBSCRIPTION_ID=e523f9df-3217-4ed7-9709-5247badceb38
AZURE_RESOURCE_GROUP=rg-dti-rag-dev
AZURE_FOUNDRY_ACCOUNT=ai-dti-rag-dev

# Storage (Lesson 04 experiment; Lesson 13 audit log)
AZURE_STORAGE_ACCOUNT=stdtiragdev

# Judge model for evaluation (Lesson 10). dev and test only; blank in prod, always.
AZURE_OPENAI_JUDGE_DEPLOYMENT=

# Groundedness detection (Lesson 11): the same Foundry resource, cognitiveservices host.
AZURE_AI_SERVICES_ENDPOINT=https://ai-dti-rag-dev.cognitiveservices.azure.com/

# The app's user-assigned managed identity (Lesson 12)
APP_IDENTITY_CLIENT_ID=6b0dd2cf-8cb7-4a1a-8f99-3e7df3635a7d

# Observability (Lesson 13)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=8a702bca-c546-45e8-9f4c-8cdc22854222;IngestionEndpoint=https://uksouth-1.in.applicationinsights.azure.com/;LiveEndpoint=https://uksouth.livediagnostics.monitor.azure.com/;ApplicationId=97e6861a-258d-499e-bb7b-7250a9159c9f
TRACE_SAMPLING_RATIO=1
